# systemd *user* unit for llama-server (Linux).
# Install:
#   mkdir -p ~/.config/systemd/user ~/.config/llama-server
#   cp llama-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now llama-server
#   journalctl --user -u llama-server -f
# Keep running after logout: loginctl enable-linger "$USER"
# %h expands to your home directory. Adjust the binary path (command -v llama-server).
# The key file must be mode 0600 and hold one key per line.

[Unit]
Description=llama.cpp server
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/llama-server \
  -m %h/models/model-Q4_K_M.gguf \
  -a local-model \
  -c 32768 \
  -ngl all \
  -fa on \
  --host 127.0.0.1 \
  --port 9931 \
  --metrics \
  --api-key-file %h/.config/llama-server/keys
# Environment=CUDA_VISIBLE_DEVICES=0
# Environment=LLAMA_CACHE=%h/.cache/llama.cpp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
