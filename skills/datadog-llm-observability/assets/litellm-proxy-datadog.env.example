# Environment for running the LiteLLM proxy under ddtrace-run (names only; put real values in a 0600 file, never in git).
# Verified against Datadog docs "Quickstart" and "Automatic Instrumentation" (LiteLLM >= 1.65.4, ddtrace >= 3.9.0), 2026-10-11.
DD_LLMOBS_ENABLED=1
DD_LLMOBS_ML_APP=local-llm-gateway
DD_SITE=datadoghq.com
# Agentless mode: no Datadog Agent on the host, spans go straight to Datadog with the API key.
DD_LLMOBS_AGENTLESS_ENABLED=1
# DD_API_KEY=   (set from the secret store; do not commit)
# Optional: keep a fraction of traces
# DD_LLMOBS_SAMPLE_RATE=1.0
# Start with: ddtrace-run litellm --config /etc/litellm/config.yaml --port 4000
