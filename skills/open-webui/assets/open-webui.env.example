# Keep real values in a 0600 file that is not committed. First boot only unless ENABLE_PERSISTENT_CONFIG=False.
WEBUI_SECRET_KEY=<openssl rand -hex 32>
# OpenAI-compatible connections: semicolon-separated, paired by position.
OPENAI_API_BASE_URLS=http://host.docker.internal:4000/v1
OPENAI_API_KEYS=<least-privilege virtual key>
# Optional per-connection settings keyed by index (Model IDs allowlist, prefix):
# OPENAI_API_CONFIGS={"0":{"enable":true,"prefix_id":"gw","model_ids":["coder","fast"]}}
# Optional capability baselines (JSON):
# DEFAULT_MODEL_METADATA={"capabilities":{"vision":false}}
# DEFAULT_MODEL_PARAMS={"temperature":0.7}
# Behind a TLS reverse proxy:
# WEBUI_URL=https://chat.example.com
# CORS_ALLOW_ORIGIN=https://chat.example.com
# Per-user identity to the gateway (audit, rate limits):
# ENABLE_FORWARD_USER_INFO_HEADERS=true
