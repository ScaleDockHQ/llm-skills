# Claude Code -> self-hosted or gateway endpoint (Anthropic Messages API).
# Copy to a private file (chmod 600) and `source` it, or move the values into the
# "env" block of ~/.claude/settings.json (never the committed .claude/settings.json).
# Docs: https://code.claude.com/docs/en/llm-gateway-connect

# Endpoint root. No /v1: Claude Code appends /v1/messages itself.
ANTHROPIC_BASE_URL=http://HOST:PORT

# Credential. Set exactly one of these two.
# Bearer header (vLLM --api-key, llama-swap, LiteLLM, any bearer-checked endpoint).
# Keyless engines (local Ollama): any non-empty dummy value.
ANTHROPIC_AUTH_TOKEN=<token-or-dummy>
# x-api-key header (llama-server --api-key on the Anthropic route):
# ANTHROPIC_API_KEY=<key>
# Rotating or vault-backed: use "apiKeyHelper" in settings instead of either variable.

# Names the endpoint serves (GET /v1/models lists them).
ANTHROPIC_MODEL=<served-model-name>
ANTHROPIC_DEFAULT_OPUS_MODEL=<served-model-name>
ANTHROPIC_DEFAULT_SONNET_MODEL=<served-model-name>
ANTHROPIC_DEFAULT_HAIKU_MODEL=<small-served-model-name>
CLAUDE_CODE_SUBAGENT_MODEL=<served-model-name>

# Real limits of the backend, for names Claude Code cannot resolve to a known Claude model.
CLAUDE_CODE_MAX_CONTEXT_TOKENS=<server-context-window>
CLAUDE_CODE_MAX_OUTPUT_TOKENS=<max-output-tokens>

# Non-Anthropic backends reject beta headers and fields.
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# Optional
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1   # /model lists ids containing "claude" or "anthropic"
# API_TIMEOUT_MS=900000                          # slow prefill or model swaps (default 600000)
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1     # no telemetry/update calls; disables auto-update
