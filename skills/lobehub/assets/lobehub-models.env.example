# Provider settings to merge into the .env next to the official LobeHub docker-compose.yml.
# Keep the file mode 0600 (chmod 600 .env). Never commit it. Replace every placeholder.

# --- OpenAI-compatible endpoint (vLLM, llama.cpp, LiteLLM, llama-swap, Ollama /v1) ---
ENABLED_OPENAI=1
OPENAI_API_KEY=PUT_KEY_HERE           # a placeholder is fine if the server has no auth, but the field must be non-empty
# Reached by the LobeHub SERVER (inside Docker): host.docker.internal or a service name, never localhost.
# Try with /v1; if replies are empty, test without (see references/connections.md).
OPENAI_PROXY_URL=http://host.docker.internal:4000/v1
# Hide built-ins, add yours. Format: id=Display Name<maxTokens:capability:capability>
OPENAI_MODEL_LIST=-all,+coder=Coder<131072:fc>,+vision=Vision<32768:vision:fc>

# --- Anthropic-compatible endpoint (a gateway that serves /v1/messages) ---
# ANTHROPIC_API_KEY=PUT_KEY_HERE
# ANTHROPIC_PROXY_URL=http://host.docker.internal:4000     # base without /v1/messages; verify with a test
# ANTHROPIC_MODEL_LIST=-all,+claude-alias=Claude Alias<200000:vision:fc>
# ANTHROPIC_CLIENT_TIMEOUT=600000       # ms

# --- Ollama ---
# OLLAMA_PROXY_URL=http://host.docker.internal:11434
# OLLAMA_MODEL_LIST=+llama3:8b=Llama 3 8B<8192:fc>

# --- Private-network endpoints (SSRF guard) ---
# Only needed for image/video URL fetching and similar server-side requests to private IPs.
# SSRF_ALLOW_PRIVATE_IP_ADDRESS=0
# SSRF_ALLOW_IP_ADDRESS_LIST=192.168.1.100
