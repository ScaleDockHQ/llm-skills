# Copy to .env next to docker-compose.yaml, chmod 600, never commit.
# Prefer scripts/gen-env.sh, which writes this file with random secrets.
LANGFUSE_TAG=4.56.0
NEXTAUTH_URL=http://localhost:3000        # exactly the URL users open, incl. protocol and port
NEXTAUTH_SECRET=                          # openssl rand -base64 32
SALT=                                     # openssl rand -base64 32 (never change after keys exist)
ENCRYPTION_KEY=                           # openssl rand -hex 32 (64 hex chars)
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
# TELEMETRY_ENABLED=false                 # opt out of anonymous usage statistics
# LANGFUSE_WEB_BIND=0.0.0.0               # only behind a firewall or TLS proxy
# LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=https://media.example.com   # browser-reachable MinIO URL
# Headless init (set all or none of a resource's variables; do not double-quote values here):
# LANGFUSE_INIT_ORG_ID=my-org
# LANGFUSE_INIT_PROJECT_ID=my-project
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-...
# LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-...
# LANGFUSE_INIT_USER_EMAIL=admin@example.com
# LANGFUSE_INIT_USER_PASSWORD=
