# Claude Code -> LLM gateway (Anthropic Messages API).
# Copy to a private file (chmod 600) and source it, or move the values into the
# "env" block of ~/.claude/settings.json (never the committed .claude/settings.json).
# Docs: https://code.claude.com/docs/en/llm-gateway-connect

# Gateway root URL. No /v1: Claude Code appends /v1/messages itself.
ANTHROPIC_BASE_URL=https://llm.example.com

# Per-tool virtual key. Sent as "Authorization: Bearer".
# Use ANTHROPIC_API_KEY instead if the gateway checks x-api-key. Set only one.
ANTHROPIC_AUTH_TOKEN=<your-virtual-key>

# Gateway aliases for each model slot.
ANTHROPIC_MODEL=claude-main
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-main
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-main
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-fast
CLAUDE_CODE_SUBAGENT_MODEL=claude-main

# Only for aliases Claude Code cannot resolve to a known Claude model:
# declare the real window and output limit of the backend.
# CLAUDE_CODE_MAX_CONTEXT_TOKENS=<context-window>
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=<max-output>

# Non-Anthropic backends behind the gateway often reject beta headers and fields.
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# Let /model list gateway models whose IDs contain "claude" or "anthropic".
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# Slow local prefill: raise the request timeout (milliseconds, default 600000).
# API_TIMEOUT_MS=900000

# Gateway-only or offline setups: no telemetry, error reporting or auto-update traffic.
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
