# Open WebUI -> LLM gateway. Pass with `docker run --env-file` or compose env_file.
# Keep the real file private (chmod 600) and out of git.
# These values seed the config on first boot. With ENABLE_PERSISTENT_CONFIG=True
# (default) later changes are made in Settings > Admin > Connections instead.
# Docs: https://docs.openwebui.com/reference/env-configuration

ENABLE_OPENAI_API=True
# Gateway on the Docker host. On Linux also add --add-host=host.docker.internal:host-gateway.
# Several endpoints: semicolon-separated, paired by position with OPENAI_API_KEYS.
OPENAI_API_BASE_URLS=http://host.docker.internal:4000/v1
# Least-privilege virtual key for Open WebUI, never the gateway master key.
OPENAI_API_KEYS=<your-virtual-key>

# Skip the local Ollama connection if you only use the gateway.
ENABLE_OLLAMA_API=False

# Baseline capabilities for every model; per-model settings override.
# DEFAULT_MODEL_METADATA={"capabilities":{"vision":false}}

# Set False to make env vars win over values saved in the UI on every restart.
# ENABLE_PERSISTENT_CONFIG=False
