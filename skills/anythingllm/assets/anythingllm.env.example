# AnythingLLM Docker: server .env (mounted at /app/server/.env). Keep it mode 0600.
# Names and variables from upstream server/.env.example and provider sources, AnythingLLM v1.17.0, 2026-10-11.
# Replace every <...> and keep real values out of chat and logs.
STORAGE_DIR="/app/server/storage"

# Instance password and token signing, needed only if the instance is reachable by others.
# AUTH_TOKEN="<instance-password>"
# JWT_SECRET="<random string, at least 12 chars>"
# SIG_KEY="<random string, at least 32 chars>"
# SIG_SALT="<random string, at least 32 chars>"
# DISABLE_TELEMETRY="true"

# ---- A) Any OpenAI-compatible server or gateway (vLLM, llama.cpp, llama-swap, LiteLLM, Ollama /v1) ----
LLM_PROVIDER='generic-openai'
GENERIC_OPEN_AI_BASE_PATH='http://host.docker.internal:4000/v1'   # must include /v1
GENERIC_OPEN_AI_MODEL_PREF='coder'                                 # exact model id the server expects
GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT=32768                            # context window; default is 4096
GENERIC_OPEN_AI_API_KEY='<key or any placeholder>'
# GENERIC_OPEN_AI_MAX_TOKENS=4096
# GENERIC_OPEN_AI_MODEL_MAX_TOKEN_KEY='max_completion_tokens'      # field name for the max-tokens value
# GENERIC_OPEN_AI_CUSTOM_HEADERS='X-Api-Key:<secret>,X-Team:llm'   # comma-separated Name:value pairs
# GENERIC_OPEN_AI_REPORT_USAGE='true'                              # sends stream_options.include_usage
# GENERIC_OPENAI_STREAMING_DISABLED='true'                         # if the server mangles streams

# ---- B) Ollama native API (no /v1) ----
# LLM_PROVIDER='ollama'
# OLLAMA_BASE_PATH='http://host.docker.internal:11434'
# OLLAMA_MODEL_PREF='qwen3:8b'
# OLLAMA_MODEL_TOKEN_LIMIT=8192
# OLLAMA_AUTH_TOKEN='<bearer token, only if Ollama sits behind auth>'
# OLLAMA_RESPONSE_TIMEOUT=7200000                                   # ms, default 5 minutes

# ---- C) LiteLLM provider ----
# LLM_PROVIDER='litellm'
# LITE_LLM_BASE_PATH='http://host.docker.internal:4000'
# LITE_LLM_MODEL_PREF='coder'
# LITE_LLM_MODEL_TOKEN_LIMIT=32768
# LITE_LLM_API_KEY='<virtual key>'

# ---- D) LocalAI-style provider (any OpenAI-compatible server) ----
# LLM_PROVIDER='localai'
# LOCAL_AI_BASE_PATH='http://host.docker.internal:8080/v1'
# LOCAL_AI_MODEL_PREF='local-model'
# LOCAL_AI_MODEL_TOKEN_LIMIT=8192
# LOCAL_AI_API_KEY='<key or placeholder>'

# ---- Agents (@agent) ----
# Force prompt-based tool use (UnTooled) for providers whose native tool calls misbehave:
# PROVIDER_DISABLE_NATIVE_TOOL_CALLING="generic-openai,litellm"
