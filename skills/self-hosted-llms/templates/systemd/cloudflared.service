# /etc/systemd/system/cloudflared.service
# Normally generated by: sudo cloudflared --config /etc/cloudflared/config.yml service install
# Shown here so you can compare. Never start the tunnel with nohup: a dead
# process means HTTP 530 for every client and nothing restarts it.
[Unit]
Description=cloudflared tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
