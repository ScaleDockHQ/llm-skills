# Copy to .env.local (git-ignored, chmod 600). Keys only here; real values stay local.
# Local OpenAI-compatible judge (deepeval set-local-model writes the same variables)
USE_LOCAL_MODEL=1
LOCAL_MODEL_NAME=<served-model-id>
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1/
LOCAL_MODEL_API_KEY=
TEMPERATURE=0
# Privacy and local-only operation
DEEPEVAL_TELEMETRY_OPT_OUT=1
# Do NOT set CONFIDENT_API_KEY unless uploading results to Confident AI is approved
