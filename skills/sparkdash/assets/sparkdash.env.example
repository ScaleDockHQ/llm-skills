# Copy to .env in the sparkDash clone. Secrets: set SPARKDASH_TOKEN from a 0600 file, never inline in history.
# Verified against sparkDash v2.32.0 .env.example and README.
PORT=5555
# Keep loopback. Use an SSH tunnel or Tailscale Serve for remote viewing.
BIND_HOST=127.0.0.1
# 0 = refuse to start on a non-loopback bind without SPARKDASH_TOKEN.
SPARKDASH_ALLOW_OPEN_REMOTE=0
# SPARKDASH_TOKEN=            # set via: ( umask 077; openssl rand -hex 24 > ~/.sparkdash.token ); then export from the file
# SPARKDASH_ALLOWED_HOSTS=dash.example.com   # only for a reverse proxy on a custom domain
LLM_PORT=8888
# POLL_INTERVAL_GPU=2000       # unset = follows Settings -> Refresh rate
POLL_INTERVAL_STORAGE=5000
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519    # path inside the container
SSH_CONTROL_PERSIST_SECONDS=60
# SPARKDASH_BENCH_HOSTS=my-box.tailnet.ts.net  # remote hosts allowed as benchmark targets
