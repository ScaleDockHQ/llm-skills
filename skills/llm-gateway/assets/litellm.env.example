# Copy to .env next to docker-compose.yaml, chmod 600, never commit.
# Generate the random values without printing them, for example:
#   umask 077; printf 'LITELLM_MASTER_KEY=sk-%s\nLITELLM_SALT_KEY=sk-%s\nPOSTGRES_PASSWORD=%s\n' \
#     "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" "$(openssl rand -hex 24)" >> .env
# and delete the empty placeholder lines below for those three names.

# Admin key for the proxy (must start with sk-). Never give it to clients.
LITELLM_MASTER_KEY=
# Encrypts credentials stored in the DB. Set once; never change after first use.
LITELLM_SALT_KEY=
# Used by compose for both Postgres and DATABASE_URL.
POSTGRES_PASSWORD=

# Provider keys referenced in litellm-config.yaml as os.environ/NAME
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
