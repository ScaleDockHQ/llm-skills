# SillyTavern config.yaml: the settings that matter for self-hosted model endpoints.
# Edit config.yaml in the install root (Docker: the mounted config directory), NOT default/config.yaml. Verified against SillyTavern 1.19.0, 2026-10-11.
# Every key can also be an environment variable: SILLYTAVERN_<UPPERCASE_NAME>, nested keys joined by underscores
# (for example SILLYTAVERN_LISTEN=true, SILLYTAVERN_PRIVATEADDRESSWHITELIST_ENABLED=true); arrays and objects as JSON strings.

listen: false # true opens it to the network: then enable the protections below
port: 8000

# Who may connect (IPs). Loopback only by default; Docker host IPs are auto-whitelisted.
whitelistMode: true
whitelist:
  - ::1
  - 127.0.0.1
  # - 192.168.1.0/24

# Login. Pick one of the two; both protect the UI, not the model endpoint.
basicAuthMode: false # legacy single browser password (basicAuthUser below)
# basicAuthUser:
#   username: user
#   password: <set a long password>
enableUserAccounts: false # per-user accounts and separate data directories

# SSRF guard for ST's own server-side requests. ST (not your browser) calls your model server,
# so with this on, private addresses must be allowed explicitly.
privateAddressWhitelist:
  enabled: false # recommended true when listen is true or untrusted users can log in
  allowedRanges:
    - 127.0.0.0/8
    - ::1/128
    # - 192.168.1.0/24 # your LAN model server
    # - 100.64.0.0/10 # Tailscale

# Show API keys again in the UI (reads secrets.json). Leave off.
allowKeysExposure: false
