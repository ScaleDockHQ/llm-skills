# Source from a 0600 file you never commit, for example: set -a; . ~/.config/goose/goose.env; set +a
# Built-in OpenAI provider against a self-hosted endpoint.
GOOSE_PROVIDER=openai
GOOSE_MODEL=coder
OPENAI_HOST=http://localhost:4000
OPENAI_BASE_PATH=v1/chat/completions
# OPENAI_API_KEY=<set in the 0600 file, never in config.yaml>
GOOSE_CONTEXT_LIMIT=131072
# GOOSE_MAX_TOKENS=8192
# Containers and headless hosts without a desktop keyring:
# GOOSE_DISABLE_KEYRING=1
